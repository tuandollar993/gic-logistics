# ==============================================================================
# GIC LOGISTICS - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Sao chép file này thành .env và điền các giá trị thực tế trước khi vận hành.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA SECRET THẬT VÀO GIT REPOSITORY.
# ==============================================================================

# Flask App Configuration
FLASK_ENV=production
FLASK_DEBUG=0
# Sinh key ngẫu nhiên mạnh: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key
SESSION_COOKIE_SECURE=1

# Database Configuration (PostgreSQL trên Supabase / RDS / Docker)
DATABASE_URL=postgresql://postgres:your_strong_password@your_db_host:5432/postgres

# Google Sheets Webhook Secret (Bắt buộc phải giống giữa .env và Apps Script)
WEBHOOK_SECRET=replace_with_a_secure_random_webhook_secret

# Telegram Bot Token cho @gidotien_bot (Theo dõi dòng tiền & OCR)
CASHFLOW_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_CHAT_IDS=chat_id_1,chat_id_2
ALLOWED_CHAT_ID=chat_id_1,chat_id_2

# Telegram Secret Token (Bắt buộc trên Production để webhook fail-closed: X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_SECRET_TOKEN=replace_with_a_secure_random_telegram_secret_token

# Bot Upload Secret (Xác thực khi bot upload file bill lên web service mà không dùng session user)
BOT_UPLOAD_SECRET=replace_with_a_secure_random_bot_upload_secret

# Render / Deployment Hostname (Dùng để kiểm tra allowlist khi thiết lập webhook)
RENDER_EXTERNAL_HOSTNAME=gic-logistics.onrender.com

# Google Gemini API Key (Dùng cho AI OCR nhận diện biên lai chuyển khoản)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token cho Bot thông báo nội bộ / Deadline
TELEGRAM_BOT_TOKEN=your_notification_bot_token_here
TELEGRAM_MANAGER_CHAT_ID=your_manager_chat_id_here

# Google Sheet ID Báo cáo dòng tiền
GIDO_SPREADSHEET_ID=1ZZC5hnoRRo93Fc3AH-mcKCu692xRhX6Zy04ENhiz6p8

# Google Service Account Credentials (dạng chuỗi JSON hoặc file data/google-credentials.json)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Initial Admin Password (chỉ dùng khi khởi tạo tài khoản admin lần đầu)
INITIAL_ADMIN_PASSWORD=replace_with_strong_admin_password
INITIAL_STAFF_PASSWORD=replace_with_strong_staff_password

